+  private static final int MAX_FORCED_RIPUPS = 3; // waffle-eda patch (D116)
+
+  /**
+   * waffle-eda patch (D116): rips up the unfixed traces and vias of other nets that block the segment from
+   * {@code from} to {@code to} on {@code layer}: the obstacle the last shove failed on, and whatever lies on
+   * the segment. Their whole connections go, as the maze's ripup removes them, and their nets are routed
+   * again in a later pass. Returns false when nothing could be ripped up.
+   */
+  private boolean ripUpBlockers(Point from, Point to, int layer, int[] netNumbers) {
+    Set<Item> candidates = new LinkedHashSet<>();
+    Item failing = board.getShoveFailingObstacle();
+    if (failing != null) {
+      candidates.add(failing);
+    }
+    ItemSelectionFilter filter =
+        new ItemSelectionFilter(
+            new ItemSelectionFilter.SelectableChoices[] {
+              ItemSelectionFilter.SelectableChoices.TRACES, ItemSelectionFilter.SelectableChoices.VIAS
+            });
+    // every item within the trace's clearance of the segment, not only those under it (a trace running
+    // alongside at less than the clearance blocks the shove as surely as one crossing)
+    if (!from.equals(to)) {
+      candidates.addAll(
+          board.overlappingItemsWithClearance(
+              new Polyline(from, to).offsetShape(ctrl.traceHalfWidth[layer], 0),
+              layer,
+              netNumbers,
+              ctrl.traceClearanceClassIndex));
+    }
+    FloatPoint a = from.toFloat();
+    FloatPoint b = to.toFloat();
+    for (int k = 0; k <= 8; k++) {
+      double t = k / 8.0;
+      IntPoint p = new FloatPoint(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t).round();
+      candidates.addAll(board.pickItems(p, layer, filter));
+    }
+    Set<Item> ripped = new java.util.TreeSet<>();
+    Set<Integer> nets = new java.util.TreeSet<>();
+    for (Item item : candidates) {
+      if (!(item instanceof Trace || item instanceof Via)) {
+        continue;
+      }
+      if (item.containsNet(netNumbers[0]) || item.getFixedState() != FixedState.UNFIXED) {
+        continue;
+      }
+      ripped.addAll(item.getConnectionItems(Item.StopConnectionOption.NONE));
+      for (int n = 0; n < item.netCount(); n++) {
+        nets.add(item.getNetNumber(n));
+      }
+    }
+    if (ripped.isEmpty()) {
+      return false;
+    }
+    board.removeItems(ripped);
+    for (int n : nets) {
+      board.removeTraceTails(n, Item.StopConnectionOption.NONE);
+    }
+    FRLogger.debug(
+        "FoundConnectionInserter: ripped up "
+            + ripped.size()
+            + " items of nets "
+            + nets
+            + " blocking net #"
+            + netNumbers[0]
+            + " on layer "
+            + layer);
+    return true;
+  }
