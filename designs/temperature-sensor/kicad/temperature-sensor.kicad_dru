(version 1)
(rule quiet
  (constraint clearance (min 0mm))
  (constraint hole_clearance (min 0mm))
  (constraint track_width (min 0mm))
  (constraint via_diameter (min 0mm))
  (constraint hole_size (min 0mm))
  (constraint annular_width (min 0mm))
  (constraint hole_to_hole (min 0mm))
  (constraint edge_clearance (min 0mm))
)
(rule board
  (constraint clearance (min 0.1400mm))
  (constraint hole_clearance (min 0.2500mm))
  (constraint edge_clearance (min 0.3000mm))
  (constraint track_width (min 0.2500mm))
  (constraint via_diameter (min 0.6000mm))
  (constraint hole_size (min 0.3000mm))
  (constraint annular_width (min 0.1500mm))
)
